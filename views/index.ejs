<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <title>Home Update — panel de mise à jour</title>
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <nav class="nav">
    <div class="brand">
      <img src="/logo.png" alt="Home Update" class="nav-logo" />
      <span class="brand-text">Home Update</span>
    </div>
    <div class="actions">
      <% if (user) { %>
        <a class="btn" href="/dashboard">Dashboard</a>
        <a class="btn danger" href="/logout">Déconnexion</a>
      <% } else { %>
        <a class="btn primary" href="/login">Connexion Discord</a>
      <% } %>
    </div>
  </nav>

  <main class="container">
    <header class="hero">
      <span class="eyebrow">Fleet control</span>
      <h1>Une commande, tous tes bots à jour.</h1>
      <p>Home Update distribue tes releases et surveille chaque instance en direct, sans FTP ni intervention manuelle.</p>
      <span class="version-pill">Dernière version : <strong><%= version %></strong></span>
    </header>

    <section class="release-strip">
      <div class="strip-left">
        <div class="version-badge"><%= version %></div>
        <div class="strip-info">
          <h3>Dernière release</h3>
          <% if (last) { %>
            <p class="notes"><%= last.notes || "Aucune note fournie." %></p>
          <% } else { %>
            <p class="notes">Aucune release disponible pour le moment.</p>
          <% } %>
        </div>
      </div>
      <div class="strip-right">
        <div class="metric">
          <div class="metric-title">Publiée le</div>
          <div class="metric-value"><%= date %></div>
        </div>
        <div class="metric">
          <div class="metric-title">Téléchargements</div>
          <div class="metric-value"><%= downloads %></div>
        </div>
      </div>
    </section>

    <section class="home-tiles">
      <div class="tile">
        <h2>Mettre à jour un bot</h2>
        <ul class="steps">
          <li><span class="n">01</span> Sur Discord, envoie la commande <strong>+update</strong>.</li>
          <li><span class="n">02</span> Le bot contacte Home Update et récupère la dernière version.</li>
          <li><span class="n">03</span> Les fichiers sont remplacés et le bot redémarre tout seul.</li>
        </ul>
        <span class="muted">Aucun accès FTP, aucune manipulation à la main : tout passe par la commande et l'API.</span>
      </div>

      <div class="tile">
        <h2>
          État de la flotte
          <span class="pulse-strip"><span></span><span></span><span></span><span></span><span></span><span></span></span>
        </h2>
        <div class="stat-grid">
          <div class="stat">
            <div class="stat-kpi"><%= totalBots %></div>
            <div class="stat-label">Bots enregistrés</div>
          </div>
          <div class="stat">
            <div class="stat-kpi"><%= upToDate %></div>
            <div class="stat-label">À jour</div>
          </div>
          <div class="stat">
            <div class="stat-kpi"><%= outdated %></div>
            <div class="stat-label">Obsolètes</div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    © <%= new Date().getFullYear() %> Home Update ·
    <a href="<%= support %>" target="_blank" rel="noopener">Support Discord</a>
  </footer>
</body>
</html>
