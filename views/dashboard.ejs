<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <title>Dashboard — AddUpdate</title>
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <nav class="nav">
    <div class="brand">
      <img src="/logo.png" alt="AddUpdate" class="nav-logo" />
      <span class="brand-text">AddUpdate</span>
    </div>
    <div class="actions">
      <a class="btn" href="/">Accueil du site</a>
      <a class="btn danger" href="/logout">Déconnexion</a>
    </div>
  </nav>

  <!-- ONGLETS CENTRÉS -->
  <div class="tabbar-wrap">
    <div class="tabbar">
      <button class="tab-btn" data-tab="home" type="button">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l9-7 9 7"/><path d="M5 10v9a1 1 0 001 1h4v-6h4v6h4a1 1 0 001-1v-9"/></svg>
        Accueil
      </button>
      <button class="tab-btn" data-tab="bots" type="button">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="8" width="16" height="12" rx="2"/><path d="M9 8V6a3 3 0 016 0v2"/><circle cx="9" cy="14" r="1"/><circle cx="15" cy="14" r="1"/></svg>
        Bots connectés
      </button>
      <button class="tab-btn" data-tab="update" type="button">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 16V4M12 4l-4 4M12 4l4 4"/><path d="M4 16v3a2 2 0 002 2h12a2 2 0 002-2v-3"/></svg>
        Mise à jour
      </button>
      <button class="tab-btn" data-tab="trash" type="button">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16"/><path d="M9 7V5a1 1 0 011-1h4a1 1 0 011 1v2"/><path d="M6 7l1 13a1 1 0 001 1h8a1 1 0 001-1l1-13"/></svg>
        Corbeille
      </button>
    </div>
  </div>

  <main class="container dash-container">

    <!-- ===================== ACCUEIL ===================== -->
    <section class="tab-panel" data-panel="home">
      <header class="page-header centered">
        <span class="eyebrow">Vue d'ensemble</span>
        <h1>Bonjour, <%= user.username %></h1>
        <p>Un coup d'œil sur l'état général du panel : releases, flotte de bots et signal en direct.</p>
      </header>

      <div class="stat-bar" style="margin:26px auto 0;">
        <div class="stat-item">
          <b><%= stats.downloads || 0 %></b>
          <span>Téléchargements</span>
        </div>
        <div class="stat-item">
          <b><%= totalBots %></b>
          <span>Bots suivis</span>
        </div>
        <div class="stat-item">
          <b><%= upToDate %></b>
          <span>À jour</span>
        </div>
        <div class="stat-item">
          <b><%= outdated %></b>
          <span>Obsolètes</span>
        </div>
      </div>

      <section class="home-tiles" style="margin-top:34px;">
        <div class="tile">
          <div class="tile-top">
            <div class="tile-badges">
              <span class="badge">Releases</span>
            </div>
            <span class="badge green"><span class="dot"></span> Actif</span>
          </div>
          <div class="tile-stat-row">
            <div class="icon-box">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 16V4M12 4l-4 4M12 4l4 4"/><path d="M4 16v3a2 2 0 002 2h12a2 2 0 002-2v-3"/></svg>
            </div>
            <div class="tile-stat">
              <b><%= latest %></b>
              <span>Version active</span>
            </div>
          </div>
          <hr class="divider" />
          <h2>Gérer les mises à jour</h2>
          <p class="sub">Uploade une nouvelle release ou restaure une ancienne version.</p>
          <div class="tile-footer">
            <button class="btn primary" type="button" data-goto-tab="update">Ouvrir →</button>
          </div>
        </div>

        <div class="tile">
          <div class="tile-top">
            <div class="tile-badges">
              <span class="badge">Flotte</span>
            </div>
            <span class="badge green"><span class="dot"></span> En direct</span>
          </div>
          <div class="tile-stat-row">
            <div class="icon-box">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="8" width="16" height="12" rx="2"/><path d="M9 8V6a3 3 0 016 0v2"/><circle cx="9" cy="14" r="1"/><circle cx="15" cy="14" r="1"/></svg>
            </div>
            <div class="tile-stat">
              <b><%= totalBots %></b>
              <span>Bots enregistrés</span>
            </div>
          </div>
          <hr class="divider" />
          <h2>Bots connectés</h2>
          <p class="sub">Statut en direct, redémarrage et mise à jour à distance.</p>
          <div class="tile-footer">
            <button class="btn primary" type="button" data-goto-tab="bots">Ouvrir →</button>
          </div>
        </div>
      </section>
    </section>

    <!-- ===================== BOTS CONNECTÉS ===================== -->
    <section class="tab-panel" data-panel="bots">
      <% const onlineCount = registeredBots.filter(b => b.live && b.live.online).length + unregisteredLive.filter(b => b.online).length; %>
      <% const totalAll = registeredBots.length + unregisteredLive.length; %>
      <% const upToDateCount = registeredBots.filter(b => b.live && b.live.botVersion === latest).length
          + unregisteredLive.filter(b => b.botVersion === latest).length; %>
      <header class="page-header centered">
        <span class="eyebrow">Live signal</span>
        <h1>
          Bots connectés
          <span class="led <%= onlineCount === 0 ? 'off' : 'on' %>" style="display:inline-block; margin-left:10px; vertical-align:middle;"></span>
        </h1>
        <p>Chaque bot s'enregistre automatiquement dès son démarrage : aucun ajout manuel n'est nécessaire.</p>
      </header>

      <div class="stat-bar" style="margin:22px auto 0;">
        <div class="stat-item"><b><%= totalAll %></b><span>Bots enregistrés</span></div>
        <div class="stat-item"><b><%= onlineCount %></b><span>En ligne</span></div>
        <div class="stat-item"><b><%= upToDateCount %></b><span>À jour</span></div>
        <div class="stat-item"><b><%= latest %></b><span>Version active</span></div>
      </div>

      <section class="bots-grid" style="margin-top:26px;">
        <% if (registeredBots.length === 0 && unregisteredLive.length === 0) { %>
          <p class="empty">Aucun bot ne s'est encore signalé. Démarre une instance : elle apparaîtra ici automatiquement.</p>
        <% } else { %>

          <% registeredBots.forEach(bot => {
               const live = bot.live;
               const currentVersion = live ? live.botVersion : (bot.stats && bot.stats.botVersion) || "Inconnue";
               const isUpToDate = currentVersion === latest;
               const online = !!(live && live.online);
          %>
            <div class="bot-card" data-id="<%= bot._id %>">
              <div class="bot-header">
                <div class="bot-title">
                  <span class="led <%= online ? 'on' : (currentVersion === 'Inconnue' ? 'off' : 'warn') %>"></span>
                  <div>
                    <div class="bot-name"><%= bot.name %></div>
                    <span class="bot-sub">Propriétaire <%= bot.ownerId || "inconnu" %> · v<%= currentVersion %></span>
                  </div>
                </div>
                <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap; justify-content:flex-end;">
                  <% if (bot.discordBotId) { %>
                    <span class="tag <%= online ? 'tag-success' : 'tag-muted' %>"><%= online ? 'En ligne' : 'Hors ligne' %></span>
                  <% } else { %>
                    <span class="tag tag-muted">Non lié au signal</span>
                  <% } %>
                  <% if (currentVersion !== "Inconnue") { %>
                    <span class="tag <%= isUpToDate ? 'tag-success' : 'tag-warn' %>"><%= isUpToDate ? 'À jour' : 'Obsolète' %></span>
                  <% } %>
                </div>
              </div>

              <div class="bot-actions">
                <button class="btn small" type="button" onclick="toggleToken(this, '<%= bot._id %>')">
                  <span class="eye-icon">👁</span> Voir le token
                </button>
                <button class="btn small" type="button" onclick="openMessageModal('<%= bot._id %>', '<%= bot.name %>')">Message privé</button>
                <form action="/owner/bots/<%= bot._id %>/restart" method="POST" style="display:inline;"
                      onsubmit="return confirm('Redémarrer ce bot à distance ?');">
                  <button type="submit" class="btn small" <%- bot.discordBotId ? '' : 'disabled title="Ajoute un ID Discord de bot pour activer cette action"' %>>Redémarrer</button>
                </form>
                <form action="/owner/bots/<%= bot._id %>/force-update" method="POST" style="display:inline;"
                      onsubmit="return confirm('Forcer la mise à jour de ce bot ?');">
                  <button type="submit" class="btn small" <%- bot.discordBotId ? '' : 'disabled title="Ajoute un ID Discord de bot pour activer cette action"' %>>Forcer la mise à jour</button>
                </form>
                <form action="/owner/bots/<%= bot._id %>/delete" method="POST" style="display:inline;"
                      onsubmit="return confirm('Supprimer cette fiche ?');">
                  <button type="submit" class="btn danger small">Supprimer</button>
                </form>
              </div>

              <div class="token-row hidden" id="token-row-<%= bot._id %>">
                <span class="token-value blurred" id="token-value-<%= bot._id %>">••••••••••••••••••••••••••••••••</span>
              </div>

              <div class="bot-details">
                <p><strong>Ajouté le :</strong> <%= new Date(bot.createdAt).toLocaleString("fr-FR") %></p>
                <% if (live) { %>
                  <p><strong>Démarré :</strong> <%= live.startedAt ? new Date(live.startedAt).toLocaleString("fr-FR") : "Inconnu" %></p>
                  <p><strong>Dernier signal :</strong> <%= live.lastCheck ? new Date(live.lastCheck).toLocaleString("fr-FR") : "Jamais" %></p>
                <% } else { %>
                  <p><strong>Dernier check :</strong> <%= bot.stats && bot.stats.lastCheck ? new Date(bot.stats.lastCheck).toLocaleString("fr-FR") : "Jamais" %></p>
                <% } %>
                <p><strong>Redémarrages :</strong> <%= (bot.stats && bot.stats.restarts) || 0 %></p>
                <p><strong>Erreurs :</strong> <%= (bot.stats && bot.stats.errors) || 0 %></p>
                <% if (bot.meta && bot.meta.notes) { %>
                  <p><strong>Notes :</strong> <%= bot.meta.notes %></p>
                <% } %>
              </div>
            </div>
          <% }) %>

          <% unregisteredLive.forEach(bot => { %>
            <div class="bot-card">
              <div class="bot-header">
                <div class="bot-title">
                  <span class="led <%= bot.online ? 'on' : 'off' %>"></span>
                  <div>
                    <div class="bot-name"><%= bot.tag || bot.botId %></div>
                    <span class="bot-sub">ID <%= bot.botId %> · v<%= bot.botVersion %> · en attente d'auto-enregistrement</span>
                  </div>
                </div>
                <span class="tag <%= bot.online ? 'tag-success' : 'tag-muted' %>"><%= bot.online ? 'En ligne' : 'Hors ligne' %></span>
              </div>
              <div class="bot-details" style="display:block; border-top:none; margin-top:12px; padding-top:0;">
                <p class="muted">Cette instance envoie un signal mais n'a pas encore fini de s'auto-enregistrer (mets le bot à jour vers la dernière version du code pour activer l'enregistrement automatique).</p>
              </div>
            </div>
          <% }) %>

        <% } %>
      </section>
    </section>

    <!-- ===================== MISE À JOUR ===================== -->
    <section class="tab-panel" data-panel="update">
      <header class="page-header centered">
        <span class="eyebrow">Deploy log</span>
        <h1>Mise à jour</h1>
        <p>Uploade une nouvelle version, gère l'historique et restaure une release précédente.</p>
      </header>

      <div class="top-actions" style="justify-content:center;">
        <a class="btn primary" href="/download/latest">Télécharger la dernière version</a>
        <span class="version-pill">Version active : <strong><%= latest %></strong></span>
      </div>

      <section class="dashboard-flex" style="margin-top:22px;">
        <div class="tile upload-card">
          <div class="tile-top">
            <div class="tile-badges">
              <span class="badge">Upload</span>
              <span class="badge orange">.zip</span>
            </div>
            <span class="badge green"><span class="dot"></span> Prêt</span>
          </div>
          <div class="tile-stat-row">
            <div class="icon-box">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 16V4M12 4l-4 4M12 4l4 4"/><path d="M4 16v3a2 2 0 002 2h12a2 2 0 002-2v-3"/></svg>
            </div>
            <div class="tile-stat">
              <b><%= releases.length %></b>
              <span>Versions publiées</span>
            </div>
          </div>
          <hr class="divider" />
          <h2>Nouvelle release</h2>
          <p class="sub">Ajoute un ZIP, quelques notes, et publie.</p>
          <form id="uploadForm" class="upload-form" action="/upload" method="post" enctype="multipart/form-data">
            <input class="input" type="text" name="version" placeholder="Numéro de version (ex : 2.6)" required />
            <textarea class="input textarea" name="notes" rows="3" placeholder="Notes de version (changements, corrections…)"></textarea>
            <div id="dropZone" class="drop-zone">
              <span id="uploadText">Glisse un fichier .zip ou clique pour le sélectionner</span>
              <input id="fileInput" type="file" name="zip" accept=".zip" hidden />
            </div>
            <div class="tile-footer" style="border-top:none; padding-top:0; justify-content:flex-start;">
              <button type="submit" class="btn primary">Uploader</button>
            </div>
          </form>
        </div>

        <div class="tile timeline-card">
          <div class="tile-top">
            <div class="tile-badges"><span class="badge">Historique</span></div>
            <span class="badge green"><span class="dot"></span> Live</span>
          </div>
          <div class="tile-stat-row">
            <div class="icon-box">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9"/><path d="M3 3v6h6"/><path d="M12 7v5l4 2"/></svg>
            </div>
            <div class="tile-stat">
              <b><%= latest %></b>
              <span>Version active</span>
            </div>
          </div>
          <hr class="divider" />
          <h2>Historique des versions</h2>
          <p class="sub">Restaure, retélécharge ou envoie une version dans la corbeille.</p>
          <% if (releases.length === 0) { %>
            <p class="empty">Aucune release disponible pour le moment.</p>
          <% } else { %>
            <ul class="release-list2">
              <% releases.forEach(r => { %>
                <li class="release-row" data-version="<%= r.version %>">
                  <div class="release-left">
                    <div class="release-dot"><%= r.version %></div>
                    <div class="release-meta">
                      <div class="release-title"><%= r.version %></div>
                      <div class="muted"><%= new Date(r.createdAt).toLocaleString("fr-FR",{dateStyle:"medium",timeStyle:"short"}) %></div>
                      <% if (r.notes) { %><div class="muted" style="margin-top:6px"><%= r.notes %></div><% } %>
                    </div>
                  </div>
                  <div class="release-actions">
                    <button class="icon-btn more-btn" aria-label="menu" data-version="<%= r.version %>">⋮</button>
                    <div class="menu hidden" id="menu-<%= r.version %>">
                      <a class="menu-item" href="/download/<%= encodeURIComponent(r.version) %>">Télécharger</a>
                      <form action="/revert/<%= encodeURIComponent(r.version) %>" method="post" style="margin:0;">
                        <button type="submit" class="menu-item">Définir comme version active</button>
                      </form>
                      <form action="/delete/<%= encodeURIComponent(r.version) %>" method="post" style="margin:0;"
                            onsubmit="return confirm('Envoyer cette release dans la corbeille ?');">
                        <button type="submit" class="menu-item danger">Envoyer dans la corbeille</button>
                      </form>
                    </div>
                  </div>
                </li>
              <% }) %>
            </ul>
          <% } %>
        </div>
      </section>
    </section>

    <!-- ===================== CORBEILLE ===================== -->
    <section class="tab-panel" data-panel="trash">
      <header class="page-header centered">
        <span class="eyebrow">Archive</span>
        <h1>Corbeille des releases</h1>
        <p>Versions supprimées du panel. Tu peux les restaurer ou les effacer définitivement.</p>
      </header>

      <section class="card" style="margin:22px auto 0; max-width:640px;">
        <h2>Releases en corbeille</h2>
        <% if (!trashItems || trashItems.length === 0) { %>
          <p class="empty">La corbeille est vide.</p>
        <% } else { %>
          <ul class="release-list2">
            <% trashItems.forEach(item => { %>
              <li class="release-row" data-version="<%= item.version %>">
                <div class="release-left">
                  <div class="release-dot"><%= item.version %></div>
                  <div class="release-meta">
                    <div class="release-title"><%= item.version %></div>
                    <div class="muted">Supprimée le <%= new Date(item.deletedAt).toLocaleString("fr-FR",{dateStyle:"medium",timeStyle:"short"}) %></div>
                    <% if (item.notes) { %><div class="muted" style="margin-top:6px"><%= item.notes %></div><% } %>
                  </div>
                </div>
                <div class="release-actions" style="display:flex; gap:6px; align-items:flex-start;">
                  <form action="/trash/restore/<%= item._id %>" method="post" style="margin:0;">
                    <button type="submit" class="btn small">Restaurer</button>
                  </form>
                  <form action="/trash/delete/<%= item._id %>" method="post" style="margin:0;"
                        onsubmit="return confirm('Supprimer définitivement cette release et son fichier ?');">
                    <button type="submit" class="btn danger small">Supprimer définitivement</button>
                  </form>
                </div>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </section>
    </section>
  </main>

  <footer class="footer">
    © <%= new Date().getFullYear() %> AddUpdate ·
    <a href="<%= support %>" target="_blank" rel="noopener">Support Discord</a>
  </footer>

  <!-- Modal message privé -->
  <div id="message-modal" class="modal hidden">
    <div class="modal-box">
      <h2>Message privé à <span id="message-bot-name"></span></h2>
      <p class="muted" style="margin:0 0 12px;">Envoyé directement par ce bot à son propriétaire, via Discord.</p>
      <form id="message-form" method="POST">
        <textarea class="input textarea" name="message" rows="4" placeholder="Ton message…" required></textarea>
        <div class="modal-actions">
          <button type="button" class="btn" onclick="closeMessageModal()">Annuler</button>
          <button type="submit" class="btn primary">Envoyer</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Zone des popups (toasts) -->
  <div id="toast-stack" class="toast-stack" aria-live="polite"></div>

  <script>
    const INITIAL_TAB = <%- JSON.stringify(tab) %>;

    /* ---------- Onglets ---------- */
    const tabButtons = document.querySelectorAll(".tab-btn");
    const tabPanels = document.querySelectorAll(".tab-panel");

    function activateTab(name, push) {
      tabButtons.forEach(b => b.classList.toggle("active", b.dataset.tab === name));
      tabPanels.forEach(p => p.classList.toggle("active", p.dataset.panel === name));
      if (push !== false) {
        const url = new URL(window.location);
        url.searchParams.set("tab", name);
        window.history.replaceState({}, "", url);
      }
    }
    tabButtons.forEach(btn => btn.addEventListener("click", () => activateTab(btn.dataset.tab)));
    document.querySelectorAll("[data-goto-tab]").forEach(el => {
      el.addEventListener("click", () => activateTab(el.dataset.gotoTab));
    });
    activateTab(INITIAL_TAB, false);

    /* ---------- Drag & drop upload ---------- */
    const drop = document.getElementById('dropZone');
    const input = document.getElementById('fileInput');
    const text = document.getElementById('uploadText');
    const form = document.getElementById('uploadForm');
    if (drop && input && text && form) {
      drop.addEventListener('click', () => input.click());
      drop.addEventListener('dragover', e => { e.preventDefault(); drop.classList.add('hover'); });
      drop.addEventListener('dragleave', () => drop.classList.remove('hover'));
      drop.addEventListener('drop', e => {
        e.preventDefault(); drop.classList.remove('hover');
        if (e.dataTransfer.files.length) {
          input.files = e.dataTransfer.files;
          text.textContent = 'Fichier sélectionné : ' + e.dataTransfer.files[0].name;
        }
      });
      input.addEventListener('change', () => {
        if (input.files.length) text.textContent = 'Fichier sélectionné : ' + input.files[0].name;
      });
      form.addEventListener('submit', () => { text.textContent = 'Upload en cours…'; });
    }

    /* ---------- Menus ⋮ ---------- */
    document.querySelectorAll('.more-btn').forEach(btn => {
      btn.addEventListener('click', e => {
        e.stopPropagation();
        const v = btn.dataset.version;
        const menu = document.getElementById('menu-' + v);
        document.querySelectorAll('.menu').forEach(m => m.classList.add('hidden'));
        if (menu) menu.classList.toggle('hidden');
      });
    });
    window.addEventListener('click', () => {
      document.querySelectorAll('.menu').forEach(m => m.classList.add('hidden'));
    });

    /* ---------- Ouvrir/fermer détails bot ---------- */
    document.querySelectorAll('.bot-header').forEach(h => {
      h.addEventListener('click', (e) => {
        if (e.target.closest('button') || e.target.closest('form')) return;
        h.parentElement.classList.toggle('open');
      });
    });

    /* ---------- Modal message privé ---------- */
    function openMessageModal(id, name) {
      document.getElementById('message-form').action = '/owner/bots/' + id + '/message';
      document.getElementById('message-bot-name').textContent = name;
      document.getElementById('message-modal').classList.remove('hidden');
    }
    function closeMessageModal() {
      document.getElementById('message-modal').classList.add('hidden');
    }

    /* ---------- Token flouté + œil ---------- */
    const tokenCache = {};
    async function toggleToken(btn, id) {
      const row = document.getElementById('token-row-' + id);
      const valueEl = document.getElementById('token-value-' + id);
      row.classList.remove('hidden');

      if (!valueEl.classList.contains('blurred')) {
        valueEl.classList.add('blurred');
        valueEl.textContent = '••••••••••••••••••••••••••••••••';
        btn.querySelector('.eye-icon').textContent = '👁';
        return;
      }

      try {
        if (!tokenCache[id]) {
          const res = await fetch(`/owner/bots/${id}/decrypt`);
          if (!res.ok) throw new Error();
          const data = await res.json();
          tokenCache[id] = data.token;
        }
        valueEl.textContent = tokenCache[id];
        valueEl.classList.remove('blurred');
        btn.querySelector('.eye-icon').textContent = '🙈';
      } catch {
        pushToast({ kind: 'error', title: 'Erreur', text: 'Impossible de récupérer le token.' });
      }
    }

    /* ---------- Toasts (popups glissantes) ---------- */
    const toastStack = document.getElementById('toast-stack');
    const activeProgressToasts = new Map(); // jobId -> element

    function pushToast({ kind = 'info', title, text, id, sticky = false }) {
      const el = document.createElement('div');
      el.className = 'toast toast-' + kind;
      el.innerHTML = `
        <div class="toast-title">${title}</div>
        <div class="toast-text">${text || ''}</div>
        <div class="toast-bar-wrap hidden"><div class="toast-bar"></div></div>
      `;
      toastStack.appendChild(el);
      requestAnimationFrame(() => el.classList.add('show'));
      if (id) el.dataset.jobId = id;
      if (!sticky) {
        setTimeout(() => dismissToast(el), 3000);
      }
      return el;
    }

    function dismissToast(el) {
      if (!el || el.dataset.removing) return;
      el.dataset.removing = "1";
      el.classList.remove('show');
      setTimeout(() => el.remove(), 350);
    }

    function upsertProgressToast(jobId, percent, botName) {
      let el = activeProgressToasts.get(jobId);
      if (!el) {
        el = pushToast({
          kind: 'info',
          title: `📦 Mise à jour — ${botName}`,
          text: `Téléchargement… ${percent}%`,
          id: jobId,
          sticky: true,
        });
        el.querySelector('.toast-bar-wrap').classList.remove('hidden');
        activeProgressToasts.set(jobId, el);
      }
      el.querySelector('.toast-text').textContent = `Téléchargement… ${percent}%`;
      el.querySelector('.toast-bar').style.width = percent + '%';
    }

    function finishProgressToast(jobId, durationSec, botName) {
      const el = activeProgressToasts.get(jobId);
      const durationText = durationSec != null ? `en ${durationSec}s` : '';
      if (el) {
        el.classList.remove('toast-info');
        el.classList.add('toast-success');
        el.querySelector('.toast-title').textContent = `✅ Mise à jour terminée — ${botName}`;
        el.querySelector('.toast-text').textContent = `Terminée ${durationText}. Redémarrage en cours…`;
        el.querySelector('.toast-bar').style.width = '100%';
        activeProgressToasts.delete(jobId);
        setTimeout(() => dismissToast(el), 3000);
      } else {
        pushToast({ kind: 'success', title: `✅ Mise à jour terminée — ${botName}`, text: `Terminée ${durationText}.` });
      }
    }

    let lastReportId = null;
    async function pollReports() {
      try {
        const url = new URL('/api/reports/recent', window.location.origin);
        if (lastReportId) url.searchParams.set('sinceId', lastReportId);
        const res = await fetch(url);
        if (!res.ok) return;
        const { reports } = await res.json();
        for (const r of reports) {
          lastReportId = r.id;
          const jobId = r.payload && r.payload.jobId;
          switch (r.type) {
            case 'update_start':
              pushToast({ kind: 'info', title: `🚀 Mise à jour démarrée — ${r.botName}`, text: 'Vérification de la nouvelle version…' });
              break;
            case 'update_progress':
              if (jobId) upsertProgressToast(jobId, r.payload.percent || 0, r.botName);
              break;
            case 'update_done':
              if (jobId) finishProgressToast(jobId, r.payload.durationSec, r.botName);
              else pushToast({ kind: 'success', title: `✅ Mise à jour terminée — ${r.botName}` });
              break;
            case 'restart':
              pushToast({ kind: 'info', title: `🔄 Redémarrage — ${r.botName}`, text: 'Le bot redémarre.' });
              break;
            case 'error':
              pushToast({ kind: 'error', title: `❌ Erreur — ${r.botName}`, text: (r.payload && r.payload.message) || '' });
              break;
            case 'ready':
              pushToast({ kind: 'success', title: `🟢 En ligne — ${r.botName}`, text: 'Le bot est de nouveau connecté.' });
              break;
          }
        }
      } catch {
        // manager hors ligne, on retentera au prochain tick
      }
    }
    pollReports();
    setInterval(pollReports, 4000);
  </script>
</body>
</html>
