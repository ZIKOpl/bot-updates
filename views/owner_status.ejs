<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <title>Bots connectés — Home Update</title>
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/style.css" />
</head>
<body class="dash">
  <!-- SIDEBAR -->
  <aside class="sidebar">
    <div class="sidebar-brand">
      <img src="/logo.png" alt="Home Update" class="sidebar-logo" />
      <span>Home Update</span>
    </div>
    <nav class="sidebar-nav">
      <a href="/dashboard">Releases</a>
      <a href="/owner/bots">Mes bots</a>
      <a href="/owner/status" class="active">Bots connectés</a>
      <a href="/trash">Corbeille</a>
      <a href="/">Accueil</a>
    </nav>
    <div class="sidebar-bottom">
      <a href="/logout" class="danger">Déconnexion</a>
    </div>
  </aside>

  <main class="dash-content">
    <% const onlineCount = bots.filter(b => b.online).length; %>
    <header class="page-header">
      <span class="eyebrow">Live signal</span>
      <h1>
        Bots connectés
        <span class="pulse-strip <%= onlineCount === 0 ? 'idle' : '' %>" style="margin-left:12px; vertical-align:middle;">
          <span></span><span></span><span></span><span></span><span></span><span></span>
        </span>
      </h1>
      <p>Chaque instance envoie un signal au manager environ toutes les 20 secondes.</p>
      <div class="header-pills">
        <span class="version-pill">Version active : <strong><%= latestVersion %></strong></span>
        <span class="version-pill">Total : <strong><%= bots.length %></strong></span>
        <span class="version-pill">En ligne : <strong><%= onlineCount %></strong></span>
      </div>
    </header>

    <section class="bots-grid" style="margin-top:22px;">
      <% if (bots.length === 0) { %>
        <p class="empty">Aucun bot ne s'est encore signalé.</p>
      <% } else { %>
        <% bots.forEach(bot => {
             const isUpToDate = bot.botVersion === latestVersion;
        %>
          <div class="bot-card">
            <div class="bot-header">
              <div class="bot-title">
                <span class="led <%= bot.online ? 'on' : 'off' %>"></span>
                <div>
                  <div class="bot-name"><%= bot.tag || bot.botId %></div>
                  <span class="bot-sub">ID <%= bot.botId %> · v<%= bot.botVersion %></span>
                </div>
              </div>
              <div style="display:flex; align-items:center; gap:8px;">
                <span class="tag <%= bot.online ? 'tag-success' : 'tag-muted' %>">
                  <%= bot.online ? 'En ligne' : 'Hors ligne' %>
                </span>
                <% if (bot.botVersion !== 'Inconnue') { %>
                  <span class="tag <%= isUpToDate ? 'tag-success' : 'tag-warn' %>">
                    <%= isUpToDate ? 'À jour' : 'Obsolète' %>
                  </span>
                <% } %>
              </div>
            </div>
            <div class="bot-details">
              <p><strong>Démarré :</strong>
                <%= bot.startedAt ? new Date(bot.startedAt).toLocaleString("fr-FR") : "Inconnu" %>
              </p>
              <p><strong>Dernier signal :</strong>
                <%= bot.lastCheck ? new Date(bot.lastCheck).toLocaleString("fr-FR") : "Jamais" %>
              </p>
            </div>
          </div>
        <% }) %>
      <% } %>
    </section>
  </main>

  <footer class="footer">
    © <%= new Date().getFullYear() %> Home Update ·
    <a href="<%= support %>" target="_blank" rel="noopener">Support Discord</a>
  </footer>

  <script>
    document.querySelectorAll('.bot-header').forEach(h => {
      h.addEventListener('click', () => h.parentElement.classList.toggle('open'));
    });
  </script>
</body>
</html>
